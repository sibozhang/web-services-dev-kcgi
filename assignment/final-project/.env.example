FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-another-long-random-value
JWT_COOKIE_SAMESITE=None
SESSION_COOKIE_SAMESITE=None
DATABASE_URL=postgresql+psycopg://mlb:mlb@db:5432/mlb
MLB_SEASON=2026
APP_TIMEZONE=Asia/Tokyo
MLB_SYNC_START=2026-03-25
MLB_SYNC_END=2026-09-27
SKIP_DB_MIGRATIONS=0
SYNC_CURRENT_INTERVAL_SECONDS=300
SYNC_DAILY_INTERVAL_SECONDS=43200
SYNC_WORKER_POLL_SECONDS=30
SYNC_WORKER_STARTUP_GRACE_SECONDS=60
GEMINI_API_KEY=
